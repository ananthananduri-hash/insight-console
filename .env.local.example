# ConvertKit (Kit) newsletter integration
# 1. Create a free account at https://kit.com
# 2. Create a Form (Grow > Landing Pages & Forms > Create New > Form)
# 3. Go to Settings > Developer to find your API Key, or copy it from the
#    form's embed code
# 4. Open the form you created; its ID is in the URL, e.g.
#    https://app.kit.com/forms/designers/1234567/edit -> form ID is 1234567
#
# Copy this file to .env.local and fill in your real values. .env.local is
# gitignored and never committed.

CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# Google Analytics 4
# 1. Go to https://analytics.google.com, create a property for this site
# 2. Add a "Web" data stream for the production URL
# 3. Copy the Measurement ID (starts with "G-")
# This one is NEXT_PUBLIC_ because it's meant to be loaded client-side.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
